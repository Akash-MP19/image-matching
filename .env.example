# Environment Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Configuration
# Primary: PostgreSQL. If PostgreSQL is unreachable and SQLITE_FALLBACK=true, SQLite is used.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/image_matching
SQLITE_FALLBACK=true

# AI Provider Configuration
# Set your Gemini API key to enable live API calls; leave blank for deterministic offline mode.
GEMINI_API_KEY=
VISION_MODEL=gemini-2.0-flash
EMBEDDING_MODEL=text-embedding-004

# Mode: true enables deterministic offline metadata & embeddings; false uses live Gemini API
OFFLINE_MODE=true

# Processing & Safety Parameters
MAX_BATCH_RETRIES=3
BATCH_RETRY_DELAY_SEC=1.0
SIMILARITY_THRESHOLD=0.55
CONFIDENCE_THRESHOLD=0.70
BUDGET_LIMIT_USD=5.00

# Data Paths
IMAGE_CORPUS_DIR=data/corpus
VISION_CACHE_FILE=data/vision_cache.json
EVAL_POSTS_FILE=data/eval_posts.json
